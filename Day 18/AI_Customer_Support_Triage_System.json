    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI customer support triage system.\n\nAnalyze the customer support message and classify it.\n\nReturn ONLY valid JSON matching the required structured output format.\n\nRules:\n- category must be exactly one of: Sales, Support, Complaint, Invoice, Spam, General\n- priority must be exactly one of: Low, Medium, High\n- sentiment must be exactly one of: Positive, Neutral, Negative\n- department should identify the appropriate department\n- summary should briefly summarize the customer's issue\n- suggested_response should provide a professional response to the customer\n- Do not add any fields outside the required schema.\n\nCustomer Message:\n{{ $json.body.message }}",
        "hasOutputParser": true,
        "batching": {}
      },
