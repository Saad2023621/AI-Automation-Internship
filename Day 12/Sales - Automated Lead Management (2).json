    },
    {
      "parameters": {
        "jsCode": "const budget = Number($json.budget);\n\nlet score;\nlet priority;\n\nif (budget >= 100000) {\n  score = 90;\n  priority = \"High Priority\";\n} else if (budget >= 50000) {\n  score = 70;\n  priority = \"Medium Priority\";\n} else {\n  score = 40;\n  priority = \"Low Priority\";\n}\n\nreturn {\n  json: {\n    ...$json,\n    score,\n    priority\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
