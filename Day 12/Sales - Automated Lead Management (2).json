    {
      "parameters": {
        "jsCode": "const lead = $json.body;\n\nreturn [\n  {\n    json: {\n      name: lead.name?.trim(),\n      email: lead.email?.trim().toLowerCase(),\n      company: lead.company?.trim(),\n      service: lead.service?.trim(),\n      budget: Number(lead.budget)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
